# Copy this to .env (docker compose reads .env automatically) and fill in
# the two values below - both are one-time, they won't change machine to
# machine unless you change users.
#
#   printf "UID=%s\nNSFW_GUARD_DATA_DIR=%s\n" "$(id -u)" "$HOME/.local/share/nsfw-guard" > .env
#
# UID isn't automatically exported by bash (it's a read-only shell
# parameter, not an environment variable), so docker compose can't see
# it directly from your shell the way it can XDG_CURRENT_DESKTOP - it
# has to come from this file instead.

UID=1000
NSFW_GUARD_DATA_DIR=/home/YOUR_USERNAME/.local/share/nsfw-guard

CAPTURE_MODE=monitor
USE_GPU=true

# monitor mode's ACTIVE-state tracking is actually paced by this, not
# ACTIVE_INTERVAL_S - lower = tighter tracking of moving content and a
# shorter "still blinking after content is gone" window during exit
# debounce, at the cost of more frequent (still brief) hide/show
# flicker. 0.15 assumes GPU inference (~60ms/frame) - raise this back
# toward 0.5-1.0 if running on CPU, where each peek round-trip costs
# ~200ms+ and a tight interval would just always be at max rate anyway.
PEEK_INTERVAL_S=0.15

# 0 = no artificial delay between ticks - runs as fast as capture+
# inference allows. Once GPU inference is actually active, this
# should comfortably clear 24fps (GPU inference on a 640x640 detector
# is typically 10-30ms/frame => 30-100fps). Set a nonzero value here
# (e.g. 0.0417 for a hard 24fps cap) if you'd rather cap it than run
# flat-out.
IDLE_INTERVAL_S=0
ACTIVE_INTERVAL_S=0

# "logout" = on a confirmed hit, blackout the screen and log the GNOME
# session out (gnome-session-quit). "box" = old behavior, draw/track a
# black box over the content instead.
ACTION_MODE=logout

# Active window, in local-time hours (24h clock). The guard only
# captures/detects between these hours - outside the window it just
# sleeps and rechecks the clock, ~0 CPU/GPU use. start > end wraps past
# midnight: 22 -> 7 means active 22:00 through 06:59. Set both equal to
# run 24/7.
GUARD_ACTIVE_START_HOUR=22
GUARD_ACTIVE_END_HOUR=7

# Uncomment to override these (defaults shown):
# WIDE_CHECK_INTERVAL_S=10.0
# ALERT_PEEK_INTERVAL_S=0.3
# HYBRID_WINDOW_STREAM_INDEX=0
# DEBUG_SNAPSHOT_DIR=/data/debug
# WINDOW_CHECK_INTERVAL_S=30.0
